[Unit]
Description=SeiyuuMatch recognition worker on port %i
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/SeiyuuMatch
ExecStart=/root/miniconda3/envs/seiyumatch/bin/python -u server.py --host 127.0.0.1 --port %i
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=4
Environment=MKL_NUM_THREADS=4
Environment=RECOGNITION_QUEUE_TIMEOUT=30
Environment=JOB_QUEUE_MAX_SIZE=200
Environment=JOB_STALE_TIMEOUT=300
Environment=RECOGNITION_WORKER_COUNT=1
Environment=SWAP_WORKER_COUNT=1
Environment=MAX_IMAGE_DIM=1280
Environment=INSIGHTFACE_DET_SIZE=640
Environment=INSIGHTFACE_DEFAULT_DET_SCORE=0.4
Environment=INSIGHTFACE_RELAXED_DET_SCORE=0.3
Environment=MAX_SWAP_UPLOAD_BYTES=20971520
Environment=MAX_SWAP_IMAGE_DIM=1024
Environment=SWAP_IDENTITY_BLEND=0.65
Environment=SWAP_RESTORE_BACKEND=codeformer
Environment=CODEFORMER_DIR=/root/CodeFormer
Environment=CODEFORMER_WEIGHT=0.5
Environment=CODEFORMER_FACE_UPSAMPLE=1
Environment=CODEFORMER_FACE_UPSAMPLE_MAX_FACES=1
Environment=CODEFORMER_FACE_UPSAMPLE_MAX_PIXELS=900000

[Install]
WantedBy=multi-user.target
